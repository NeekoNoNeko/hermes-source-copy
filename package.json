{
  "name": "hermes-source-copy",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "description": "Copy original Markdown and LaTeX selections in Hermes Desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/NeekoNoNeko/hermes-source-copy.git"
  },
  "homepage": "https://github.com/NeekoNoNeko/hermes-source-copy",
  "bugs": {
    "url": "https://github.com/NeekoNoNeko/hermes-source-copy/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run test",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  },
  "dependencies": {
    "entities": "^6.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "jsdom": "^26.1.0",
    "katex": "^0.18.2",
    "remark-rehype": "^11.1.2",
    "rehype-stringify": "^10.0.1",
    "rehype-katex": "^7.0.1"
  },
  "overrides": {
    "katex": "$katex"
  }
}
